# Login that owns the schema and creates the two logins below. Only seed.py uses it.
DATABASE_ADMIN_URL=postgresql+psycopg://postgres:postgres@localhost:5432/erp_ai

# Login the app runs as. It may read the ERP tables and make the business
# actions' writes, nothing else. seed.py creates it; use a long random password.
DATABASE_URL=postgresql+psycopg://erp_app:change_me@localhost:5432/erp_ai

# Login that model-generated SQL runs as. It may only read the ERP tables.
# seed.py creates it with this name and password; use a long random password.
READONLY_DATABASE_URL=postgresql+psycopg://erp_readonly:change_me@localhost:5432/erp_ai

# Groq credentials used by langchain-groq. Copy this file to .env and fill it in.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Key you enter once in the browser to open the web app. Use a long random value.
ERP_ACCESS_KEY=change_me

# Optional LangSmith observability. Tracing is disabled unless explicitly enabled.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=erp-ai-agent

