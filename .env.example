# PostgreSQL connection used by SQLAlchemy.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/erp_ai

# Groq credentials used by langchain-groq. Copy this file to .env and fill it in.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional LangSmith observability. Tracing is disabled unless explicitly enabled.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=erp-ai-agent

